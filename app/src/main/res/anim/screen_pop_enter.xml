<?xml version="1.0" encoding="utf-8"?>
<!-- BACK: previous screen glides back from the left into place (exact reverse of screen_exit). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:duration="380"
        android:fromXDelta="-30%p"
        android:interpolator="@interpolator/slide_ease"
        android:toXDelta="0%" />
</set>
