<?xml version="1.0" encoding="utf-8"?>
<!-- Back: previous screen comes back from the left : pure slide, no alpha change, so the screen never blinks -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:duration="350"
        android:fromXDelta="-25%p"
        android:interpolator="@interpolator/emphasized_decelerate"
        android:toXDelta="0%" />
</set>
