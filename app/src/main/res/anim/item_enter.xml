<?xml version="1.0" encoding="utf-8"?>
<!-- Rows rise, fade and settle in a gentle cascade. Used by list layout animations. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="480"
    android:interpolator="@interpolator/emphasized_decelerate">
    <alpha
        android:duration="300"
        android:fromAlpha="0"
        android:toAlpha="1" />
    <translate
        android:fromYDelta="14%"
        android:toYDelta="0%" />
    <scale
        android:fromXScale="0.98"
        android:fromYScale="0.98"
        android:pivotX="50%"
        android:pivotY="0%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
