<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 fade through (incoming): fade in after a short beat -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha
        android:duration="210"
        android:fromAlpha="0"
        android:interpolator="@interpolator/standard_decelerate"
        android:startOffset="90"
        android:toAlpha="1" />
</set>
