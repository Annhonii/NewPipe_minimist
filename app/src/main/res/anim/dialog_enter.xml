<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@interpolator/emphasized_decelerate">
    <alpha
        android:duration="180"
        android:fromAlpha="0"
        android:toAlpha="1" />
    <scale
        android:fromXScale="0.88"
        android:fromYScale="0.88"
        android:pivotX="50%"
        android:pivotY="55%"
        android:toXScale="1"
        android:toYScale="1" />
    <translate
        android:fromYDelta="3%"
        android:toYDelta="0%" />
</set>
