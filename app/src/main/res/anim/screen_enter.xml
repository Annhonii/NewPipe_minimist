<?xml version="1.0" encoding="utf-8"?>
<!-- Forward: new screen slides in from the right : pure slide, no alpha change, so the screen never blinks -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:duration="350"
        android:fromXDelta="100%p"
        android:interpolator="@interpolator/emphasized_decelerate"
        android:toXDelta="0%" />
</set>
