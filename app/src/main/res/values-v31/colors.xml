<?xml version="1.0" encoding="utf-8"?>
<!-- Material You (dynamic colour, Android 12+): the whole app surface follows the wallpaper colours
     instead of the fixed icy blue-grey. Same resource names as values/colors.xml, so every theme
     attribute (windowBackground, card_item_background_color, ...) picks them up automatically.
     Mapping (Material 3 roles): background = surface, card / dialog = surface container,
     card contrast = surface container highest, top bar = surface container, pill = secondary container.
     Older Android versions keep the fixed colours from values/colors.xml. -->
<resources>
    <!-- Light -->
    <color name="light_background_color">@android:color/system_neutral1_10</color>
    <color name="light_dialog_background_color">@android:color/system_neutral1_50</color>
    <color name="light_card_item_background_color">@android:color/system_neutral1_50</color>
    <color name="light_card_item_contrast_color">@android:color/system_neutral1_100</color>
    <!-- Dark -->
    <color name="dark_background_color">@android:color/system_neutral1_900</color>
    <color name="dark_dialog_background_color">@android:color/system_neutral1_800</color>
    <color name="dark_card_item_background_color">@android:color/system_neutral1_800</color>
    <color name="dark_card_item_contrast_color">@android:color/system_neutral1_700</color>
    <!-- Black -->
    <color name="black_background_color">@android:color/system_neutral1_1000</color>
    <color name="black_card_item_background_color">@android:color/system_neutral1_900</color>
    <color name="black_card_item_contrast_color">@android:color/system_neutral1_800</color>

    <!-- Top bar: bar = surface container, search pill / buttons = secondary container -->
    <color name="m3_toolbar_container_light">@android:color/system_neutral1_50</color>
    <color name="m3_toolbar_element_light">@android:color/system_accent2_100</color>
    <color name="m3_toolbar_container_dark">@android:color/system_neutral1_800</color>
    <color name="m3_toolbar_element_dark">@android:color/system_accent2_700</color>
    <color name="m3_toolbar_container_black">@android:color/system_neutral1_900</color>
    <color name="m3_toolbar_element_black">@android:color/system_accent2_800</color>
</resources>
