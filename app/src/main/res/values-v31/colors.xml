<?xml version="1.0" encoding="utf-8"?>
<!-- Material You (dynamic colour, Android 12+): the top bar follows the wallpaper colours.
     Bar = surface container, pill / buttons = secondary container (the Material 3 search bar recipe).
     Older Android versions keep the fixed colours from values/colors.xml. -->
<resources>
    <color name="m3_toolbar_container_light">@android:color/system_neutral1_50</color>
    <color name="m3_toolbar_element_light">@android:color/system_accent2_100</color>
    <color name="m3_toolbar_container_dark">@android:color/system_neutral1_900</color>
    <color name="m3_toolbar_element_dark">@android:color/system_accent2_700</color>
    <color name="m3_toolbar_container_black">@android:color/system_neutral1_1000</color>
    <color name="m3_toolbar_element_black">@android:color/system_accent2_800</color>
</resources>
