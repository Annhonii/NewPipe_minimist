<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 shared axis X, back: previous screen fades in after 90ms while moving in from the left -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">
    <objectAnimator
        android:duration="210"
        android:interpolator="@android:interpolator/linear"
        android:propertyName="alpha"
        android:startOffset="90"
        android:valueFrom="0.0f"
        android:valueTo="1.0f" />
    <objectAnimator
        android:duration="300"
        android:interpolator="@interpolator/emphasized_decelerate"
        android:propertyName="translationX"
        android:valueFrom="-30dp"
        android:valueTo="0dp"
        android:valueType="floatType" />
</set>
