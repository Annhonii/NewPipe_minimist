<?xml version="1.0" encoding="utf-8"?>
<!-- Floating nav capsule: a fully rounded lighter-grey container with a hairline edge.
     The selected tab sits in a darker inner capsule (nav_pill_indicator). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/card_item_contrast_color" />
    <corners android:radius="40dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/card_item_background_color" />
</shape>
