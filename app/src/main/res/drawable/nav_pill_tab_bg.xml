<?xml version="1.0" encoding="utf-8"?>
<!-- Background of one nav pill tab: a soft rounded highlight when the tab is selected.
     It is drawn by the tab itself (no sliding indicator), so it always fits, also on the
     last tab. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset
            android:insetLeft="2dp"
            android:insetTop="0dp"
            android:insetRight="2dp"
            android:insetBottom="0dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/card_item_contrast_color" />
                <corners android:radius="22dp" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
