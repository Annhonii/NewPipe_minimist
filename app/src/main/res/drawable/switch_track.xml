<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing-style switch track: 56x32 pill. On = Nothing red, off = dark grey (light grey in light mode). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nothing_red" />
            <size android:width="56dp" android:height="32dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/switch_track_off_color" />
            <stroke android:width="1.5dp" android:color="?android:attr/textColorPrimary" />
            <size android:width="56dp" android:height="32dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
