<?xml version="1.0" encoding="utf-8"?>
<!-- Round action button beside the floating nav pill: same surface + hairline as the pill,
     with a ripple that is clipped to the circle. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/card_item_background_color" />
            <stroke
                android:width="1dp"
                android:color="?attr/separator_color" />
        </shape>
    </item>
</ripple>
