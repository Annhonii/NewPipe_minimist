<?xml version="1.0" encoding="utf-8"?>
<!-- Round action button beside the floating nav pill: same surface as the pill, no outline,
     with a ripple that is clipped to the circle. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <!-- lit while the nav pill is being dragged over this button -->
            <item android:state_selected="true">
                <shape android:shape="oval">
                    <solid android:color="?android:attr/textColorPrimary" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?attr/card_item_background_color" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
