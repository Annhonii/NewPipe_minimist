<?xml version="1.0" encoding="utf-8"?>
<!-- Account button: person icon when signed out, Google photo when signed in.
     The outer frame carries a 4dp gutter per side, so neighbouring buttons are 8dp apart. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <FrameLayout
        android:id="@+id/account_button"
        android:stateListAnimator="@animator/press_scale"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_icon_button"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/account_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/yt_account_title"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_person" />
    </FrameLayout>
</FrameLayout>
