<?xml version="1.0" encoding="utf-8"?>
<!-- Content of one nav pill tab: icon, plus the tab name that only the selected tab shows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/nav_tab_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:tint="@color/nav_pill_tab_tint" />

    <TextView
        android:id="@+id/nav_tab_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/geist"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/nav_pill_tab_tint"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
