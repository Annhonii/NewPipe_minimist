<?xml version="1.0" encoding="utf-8"?>
<!-- Category header of the settings screens: just the title. The spacing between groups comes
     from SegmentedPreferenceAdapter, so there is no shaded band or hard divider line here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/settings_category_header_title" />
</LinearLayout>
